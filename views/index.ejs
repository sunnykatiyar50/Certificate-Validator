<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        :root {
            --primary-color: #4285F4;
            --secondary-color: #34A853;
            --accent-color: #FBBC05;
            --error-color: #EA4335;
            --background-color: #f9f9f9;
            --card-color: #ffffff;
            --text-color: #333333;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            max-width: 900px;
            margin: 0 auto;
            padding: 30px;
            background-color: var(--background-color);
            color: var(--text-color);
            line-height: 1.6;
        }

        .container {
            background-color: var(--card-color);
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 30px;
            margin-bottom: 30px;
        }

        h1 {
            color: var(--primary-color);
            text-align: center;
            margin-bottom: 30px;
            font-size: 2.2rem;
        }

        .tabs {
            display: flex;
            margin-bottom: 20px;
            border-bottom: 1px solid #ddd;
        }

        .tab {
            padding: 10px 20px;
            cursor: pointer;
            border: none;
            background: none;
            font-size: 16px;
            font-weight: 600;
            color: #666;
            position: relative;
        }

        .tab.active {
            color: var(--primary-color);
        }

        .tab.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 3px;
            background-color: var(--primary-color);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .form-group {
            margin-bottom: 25px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: var(--text-color);
        }

        input[type="file"] {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            background-color: #f5f5f5;
        }

        textarea {
            width: 100%;
            min-height: 200px;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 4px;
            resize: vertical;
            font-family: monospace;
            font-size: 14px;
        }

        button {
            padding: 12px 24px;
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: background-color 0.3s;
            margin-right: 10px;
        }

        button:hover {
            background-color: #3367d6;
        }

        .clear-btn {
            background-color: var(--accent-color);
        }

        .clear-btn:hover {
            background-color: #e0a800;
        }

        .button-group {
            display: flex;
            margin-top: 20px;
        }

        #result {
            margin-top: 30px;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #ddd;
            background-color: #f5f5f5;
            display: none;
        }

        .result-valid {
            border-left: 4px solid var(--secondary-color);
        }

        .result-invalid {
            border-left: 4px solid var(--error-color);
        }

        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        .details-table th, .details-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        .details-table th {
            width: 30%;
            font-weight: 600;
        }

        .valid-badge {
            display: inline-block;
            padding: 4px 8px;
            background-color: var(--secondary-color);
            color: white;
            border-radius: 4px;
            font-size: 14px;
        }

        .invalid-badge {
            display: inline-block;
            padding: 4px 8px;
            background-color: var(--error-color);
            color: white;
            border-radius: 4px;
            font-size: 14px;
        }

        .error-message {
            color: var(--error-color);
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1><%= title %></h1>

        <div class="tabs">
            <button class="tab active" data-tab="file-upload">Upload Certificate File</button>
            <button class="tab" data-tab="text-input">Enter Certificate Text</button>
        </div>

        <div class="tab-content active" id="file-upload">
            <form id="certificate-file-form" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="certificate">Upload Certificate File (.pem, .crt, .cer, .der):</label>
                    <input type="file" id="certificate" name="certificate" required>
                </div>
                <div class="button-group">
                    <button type="submit">Validate Certificate</button>
                    <button type="button" class="clear-btn" id="clear-file">Clear</button>
                </div>
            </form>
        </div>

        <div class="tab-content" id="text-input">
            <form id="certificate-text-form">
                <div class="form-group">
                    <label for="certificate-text">Paste Certificate Content:</label>
                    <textarea id="certificate-text" name="certificateText" placeholder="-----BEGIN CERTIFICATE-----&#10;...&#10;-----END CERTIFICATE-----" required></textarea>
                </div>
                <div class="button-group">
                    <button type="submit">Validate Certificate</button>
                    <button type="button" class="clear-btn" id="clear-text">Clear</button>
                </div>
            </form>
        </div>

        <div id="result"></div>
        <div class="button-group" id="result-buttons" style="display: none; margin-top: 15px;">
            <button type="button" class="clear-btn" id="clear-results">Clear Results</button>
        </div>
    </div>

    <script>
        // Tab switching
        document.querySelectorAll('.tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

                tab.classList.add('active');
                document.getElementById(tab.dataset.tab).classList.add('active');
            });
        });

        // File upload form submission
        document.getElementById('certificate-file-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            validateCertificate(formData, '/validate-certificate');
        });

        // Text input form submission
        document.getElementById('certificate-text-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const certificateText = document.getElementById('certificate-text').value;

            // Create a file from the text
            const blob = new Blob([certificateText], { type: 'application/x-x509-ca-cert' });
            const file = new File([blob], 'certificate.pem');

            const formData = new FormData();
            formData.append('certificate', file);

            validateCertificate(formData, '/validate-certificate');
        });

        // Function to validate certificate
        async function validateCertificate(formData, url) {
            const resultDiv = document.getElementById('result');
            const resultButtonsDiv = document.getElementById('result-buttons');
            resultDiv.className = '';

            try {
                resultDiv.innerHTML = '<p>Processing certificate...</p>';
                resultDiv.style.display = 'block';

                const response = await fetch(url, {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }

                const data = await response.json();

                if (data.valid) {
                    resultDiv.className = 'result-valid';
                    let resultHTML = `<h3>Certificate Status: <span class="valid-badge">Valid ✓</span></h3>`;

                    resultHTML += '<h4>Certificate Details:</h4>';
                    resultHTML += '<table class="details-table">';

                    for (const [key, value] of Object.entries(data.details)) {
                        resultHTML += `<tr><th>${key}</th><td>${value}</td></tr>`;
                    }

                    resultHTML += '</table>';
                    resultDiv.innerHTML = resultHTML;
                } else {
                    resultDiv.className = 'result-invalid';
                    let resultHTML = `<h3>Certificate Validation Failed ✗</h3>`;

                    if (data.error) {
                        resultHTML += `<p class="error-message">Error: ${data.error}</p>`;
                    } else if (data.details) {
                        resultHTML += `<p class="error-message">Error: Certificate is expired</p>`;

                        resultHTML += '<h4>Certificate Details:</h4>';
                        resultHTML += '<table class="details-table">';

                        for (const [key, value] of Object.entries(data.details)) {
                            resultHTML += `<tr><th>${key}</th><td>${value}</td></tr>`;
                        }

                        resultHTML += '</table>';
                    }

                    resultDiv.innerHTML = resultHTML;
                }
                // Show the clear results button
                resultButtonsDiv.style.display = 'flex';
            } catch (error) {
                resultDiv.className = 'result-invalid';
                resultDiv.innerHTML = `<h3>Error ✗</h3><p class="error-message">${error.message}</p>`;
                console.error('Error:', error);
                // Show the clear results button even on error
                resultButtonsDiv.style.display = 'flex';
            }
        }

        // Clear file input
        document.getElementById('clear-file').addEventListener('click', () => {
            document.getElementById('certificate-file-form').reset();
        });

        // Clear text input
        document.getElementById('clear-text').addEventListener('click', () => {
            document.getElementById('certificate-text').value = '';
        });

        // Clear results
        document.getElementById('clear-results').addEventListener('click', () => {
            const resultDiv = document.getElementById('result');
            const resultButtonsDiv = document.getElementById('result-buttons');
            resultDiv.innerHTML = '';
            resultDiv.className = '';
            resultDiv.style.display = 'none';
            resultButtonsDiv.style.display = 'none';
        });
    </script>
</body>
</html>
