# Copy this file to .env and edit it. Docker Compose reads .env automatically,
# and .env is git-ignored, so it is safe for local settings.
#   cp sample.env .env

# Image tag to run (see the Packages page on GitHub). Use "latest" for the newest build,
# or pin a release such as 1.1.1 for deployments.
APP_VERSION=latest

# Port on the host that the app is published on (the container always listens on 30002).
HOST_PORT=30002

# Set to 1 when running behind a reverse proxy so rate limiting sees real client IPs.
TRUST_PROXY=

# Comma-separated origins allowed to call the API from another site. Leave empty to disable CORS.
CORS_ORIGIN=

# For running without Docker ("npm start"), these are read from the environment instead:
#   PORT=30002               port to listen on
#   ALLOW_PRIVATE_HOSTS=1    let live checks reach private/loopback addresses (local use only)
