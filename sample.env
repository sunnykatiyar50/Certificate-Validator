# Copy this file to .env and edit it. Docker Compose reads .env automatically,
# and .env is git-ignored, so it is safe for local settings.
#   cp sample.env .env
#
# Values containing a "$" must be written as "$$" (or wrapped in single quotes) for Docker Compose.

# ---------- sign-in ----------

# Administrator account. The admin can see every user's history.
ADMIN_USERNAME=admin
# Required. At least 8 characters. Either plain text or a hash from "npm run hash-password".
ADMIN_PASSWORD=

# Regular users as name:password pairs separated by commas, for example:
#   USERS=alice:alice-password,bob:bob-password
# Usernames: letters, digits and . _ @ - (up to 64). Passwords: at least 8 characters, and plain-text
# passwords cannot contain a comma. Users only see their own history. Use hashes to avoid plain text:
#   USERS=alice:scrypt:16384:8:1:...:...
USERS=

# Required. At least 32 random characters; signs the session cookie. Generate one with:
#   npm run hash-password -- --secret
# Changing it, or a user's password, signs everyone (or that user) out.
SESSION_SECRET=

# How long a sign-in lasts, in hours.
SESSION_TTL_HOURS=12

# Optional. At least 32 random characters. Encrypts private keys and CAs that users choose to keep on the server.
# Without it a random key is created once in the data folder. Set it so the data folder alone cannot decrypt them.
# Losing it makes saved server-side keys unreadable.
VAULT_KEY=

# ---------- container ----------

# Image tag to run (see the Packages page on GitHub). Use "latest" for the newest build,
# or pin a release such as 1.1.1 for deployments.
APP_VERSION=latest

# Port on the host that the app is published on (the container always listens on 33003).
HOST_PORT=33003

# Set to 1 when running behind a reverse proxy so rate limiting sees real client IPs.
TRUST_PROXY=

# Comma-separated origins allowed to call the API from another site. Leave empty to disable CORS.
CORS_ORIGIN=

# ---------- running without Docker ("npm start") ----------
# These are read from the environment (or exported in your shell) instead:
#   PORT=33003               port to listen on
#   DATA_DIR=./data          where the history database is kept
#   AUTH_DISABLED=1          skip sign-in entirely (everyone is an admin). Local development only.
#   ALLOW_PRIVATE_HOSTS=1    let live checks reach private/loopback addresses (local use only)
